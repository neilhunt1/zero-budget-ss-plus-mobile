# Copy to .env.development or .env.production and fill in values.
# Never commit .env.development or .env.production — they contain secrets.

# ── Google Sheets backend (used by setup scripts) ─────────────────────────────

# The ID of the Google Sheet (from the URL: /spreadsheets/d/<SHEET_ID>/edit)
# GOOGLE_SHEET_ID is the "active" sheet ID for whatever environment is currently running.
# In a local development environment, you would set this to your dev sheet ID.
# In CI, it gets injected dynamically based on the environment being tested.
GOOGLE_SHEET_ID=your_env-specific_sheet_id_here

# Reference variables for specific environments (used by syncing scripts like sync-from-prod-to-dev)
PROD_GOOGLE_SHEET_ID=your_prod_sheet_id
DEV_GOOGLE_SHEET_ID=your_dev_sheet_id
TEST_GOOGLE_SHEET_ID=your_test_sheet_id

GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/Users/bob/Code/zero-based-budget-123456-4569fabc261e.json
# Service account credentials (choose one):

# Option A — Inline JSON key contents (recommended for cloud/CI environments).
# Paste the entire contents of your service account JSON key as a single line.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Option B — Path to a local JSON key file (recommended for local development).
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# ── React frontend (Vite) ─────────────────────────────────────────────────────
# These are embedded in the browser bundle — do NOT put secrets here.
# For local dev, create .env.development.local with these values.

# Google OAuth Client ID (web application type).
# Create at: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorised JavaScript origins: http://localhost:5173 (dev) + your prod domain
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Same active Sheet ID as above, exposed to the browser for direct API calls.
VITE_GOOGLE_SHEET_ID=your_sheet_id_here
